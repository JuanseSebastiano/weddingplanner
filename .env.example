# URL del proyecto de Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave publishable / anon (es pública, la protege RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# --- Finanzas (solo servidor, nunca NEXT_PUBLIC_) ---------------------
# Service role del mismo proyecto: la API de finanzas y el cron la usan
# filtrando siempre por couple_id.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel manda "Authorization: Bearer $CRON_SECRET" al disparar el cron.
CRON_SECRET=
# Gmail (opcional). Google Cloud Console > Credentials > OAuth client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/fin/gmail/oauth/callback
# openssl rand -hex 32
GMAIL_TOKEN_ENCRYPTION_KEY=
# Opcionales
GMAIL_SEARCH_QUERY=
GMAIL_WEBHOOK_SECRET=
GMAIL_MAX_MESSAGES_PER_SYNC=50
# A dónde vuelve el OAuth de Gmail (default: la URL de producción de Vercel).
WEB_ORIGIN=
